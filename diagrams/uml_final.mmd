classDiagram
    class Owner {
        +String first_name
        +String last_name
        +List~Pet~ pets
        +full_name() String
        +add_pet(pet) None
        +get_all_tasks() List~Task~
    }

    class Pet {
        +String name
        +int age
        +String sex
        +String breed
        +List~Task~ tasks
        +summary() String
        +add_task(task) None
    }

    class Task {
        +String title
        +int duration_minutes
        +String priority
        +String description
        +String frequency
        +bool completed
        +mark_complete() None
        +next_occurrence() Task
    }

    class ScheduledTask {
        +Task task
        +String start_time
        +String end_time
        +String reason
        +display() String
    }

    class Schedule {
        +Owner owner
        +Pet pet
        +int available_minutes
        +String reason
        +List~ScheduledTask~ scheduled_tasks
        +String summary
        +total_duration() int
        +display() String
    }

    class Scheduler {
        +generate_schedule(owner, pet, tasks, available_minutes, start_time) Schedule
        +sort_by_time(scheduled_tasks) List~ScheduledTask~
        +filter_tasks_by_pet(pets, pet_name) List~Task~
        +detect_conflicts(scheduled_tasks) List~String~
        +reschedule_completed_tasks(pet) List~Task~
        -_advance_time(time_str, minutes) String
        -_build_prompt(owner, pet, tasks) String
        -_parse_response(tasks, start_time, response) List~ScheduledTask~
    }

    Owner "1" --o "0..*" Pet : owns
    Pet "1" --o "0..*" Task : has
    Schedule "1" --> "1" Owner : belongs to
    Schedule "1" --> "1" Pet : is for
    Schedule "1" *-- "0..*" ScheduledTask : contains
    ScheduledTask "1" --> "1" Task : wraps
    Task ..> Task : next_occurrence() creates
    Scheduler ..> Owner : uses
    Scheduler ..> Pet : uses
    Scheduler ..> Task : uses
    Scheduler ..> ScheduledTask : creates
    Scheduler ..> Schedule : creates
